# Values below are the only ones that must be typed by hand.
# Cluster/vpc/subnets/SG/OIDC come from data sources - keep them out of tfvars.
region                = "ap-southeast-2"
domain                = "mlbox.june8th.me"     # hub at notebook.<domain>, dashboard at the apex
cognito_domain_prefix = "mlbox-hub-apse2"     # unique per region

# 00-bootstrap owns the persistent Route53 zone, ACM certificates and validation
# records. 02-platform creates only the ALB and its A-alias records in that zone.
manage_route53 = true
# route53_zone_id is deprecated; leave it empty so the tagged bootstrap zone is discovered.
