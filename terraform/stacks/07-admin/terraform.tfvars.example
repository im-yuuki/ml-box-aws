region = "ap-southeast-2"
domain = "example.com"

# Published to GHCR by .github/workflows/images.yml. Use the full commit SHA.
admin_image = "ghcr.io/<owner>/mlbox-admin:<40-char-commit-sha>"

admin_username = "admin"
# ADMIN_PASSWORD='a long passphrase' npm run hash-password   (in web/admin)
admin_password_hash = "scrypt$16384$8$1$<salt>$<hash>"

# Optional: restrict the console to your own address.
# admin_allowed_cidrs = ["203.0.113.7/32"]

enable_database      = true
enable_cost_explorer = false

# Changes from the console (stop a sandbox, lock an account, sign a user out, change a plan). Off keeps it read-only.
enable_actions = false

# First apply: false creates IAM, certificate, DNS and target group only.
deploy_admin = false
