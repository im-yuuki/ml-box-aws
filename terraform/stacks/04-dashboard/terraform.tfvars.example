region = "ap-southeast-2"
domain = "example.com"

# Images published to GHCR by .github/workflows/images.yml before apply. Use the full commit SHA.
dashboard_image = "ghcr.io/<owner>/mlbox-dashboard:<40-char-commit-sha>"
bff_image       = "ghcr.io/<owner>/mlbox-bff:<40-char-commit-sha>"

# Terraform reads the sensitive Hub service token from 03-hub-app remote state
# and generates the BFF session-encryption key in this stack.
# Realtime usage quotas are policy limits; historical CPU/storage accounting is not enabled.
cpu_quota_hours    = 32
ram_quota_gb       = 24
storage_quota_gb   = 20
gpu_quota_hours     = 0

# First apply: set false to create TG only, then flip true after push.
deploy_dashboard = false
