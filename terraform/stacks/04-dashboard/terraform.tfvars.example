region = "ap-southeast-2"
domain = "example.com"

# Images must be pushed to ECR before apply. Tags = dev-<sha>.
dashboard_image = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/jhub-gpu-sandbox/dashboard:dev-abcdef1"
bff_image       = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/jhub-gpu-sandbox/bff:dev-abcdef1"

# Terraform reads the sensitive Hub service token from 03-hub-app remote state
# and generates the BFF session-encryption key in this stack.

# First apply: set false to create ECR + TG only, then flip true after push.
deploy_dashboard = false
