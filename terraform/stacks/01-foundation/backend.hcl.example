# Per-region backend state - one cluster per region, apply one region at a time.
# Usage: terraform init -backend-config=backend.hcl
# Never share a state key across regions. NOTE: 00-bootstrap now GENERATES the real
# backend.hcl into this stack (bucket name derived from the account ID) - this file
# is only a manual fallback if you'd rather craft it by hand.
bucket         = "REPLACEME-tfstate" # the S3 bucket created by 00-bootstrap (versioning + encryption enabled)
key            = "dev/ap-southeast-2/01-foundation.tfstate"
region         = "ap-southeast-2"
dynamodb_table = "REPLACEME-tflock" # the DynamoDB lock table created by 00-bootstrap
encrypt        = true
