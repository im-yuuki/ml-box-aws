# Versions filled in and verified on 2026-10-12. Re-check before each fresh apply.
# region = "ap-southeast-2"  # Sydney (first). Options: ap-southeast-1, ap-southeast-3
# See docs/regions.md — CIDR/AZ derive from the region; apply only 1 region at a time.
# karpenter_chart_version = "1.15.0"  # chart v1 has no "v" prefix
# karpenter_version       = "v1.15.0"  # app version (keep the "v" prefix)
# cluster_version   = "1.36"
# enable_vpc_interface_endpoints = false  # dev; prod switches to true

# NAT mode:
# - "managed_per_az" (default, HA): 1 NAT GW/AZ, ~$43/month per NAT in Sydney + $0.059/GB
# - "fck_nat": t4g.nano NAT instance ~$5/month for legacy IPv4
# - "none": IPv6-only, 0 NAT cost. IPv4 only through VPC endpoints (S3/ECR/STS).
#   Note: IPv4 pods have no internet in none mode — the image/registry must be IPv6 or go through an endpoint.
# nat_mode = "managed_per_az"
# nat_mode = "none"  # max savings for dev, once workloads are IPv6-ready
