name: CI build and scan (disabled)

on:
  pull_request:
  push:
    branches: [master]
    tags: ["v*.*.*"]

permissions:
  contents: read

jobs:
  images:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        include:
          - name: dashboard
            context: .
            file: web/dashboard/Dockerfile
            image: dashboard
          - name: bff
            context: .
            file: web/bff/Dockerfile
            image: bff
          - name: notebook-cpu
            context: .
            file: images/cpu/Dockerfile
            image: jhub-gpu-sandbox/cpu
          - name: notebook-gpu
            context: .
            file: images/gpu/Dockerfile
            image: jhub-gpu-sandbox/gpu
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - name: Build image
        uses: docker/build-push-action@v6
        with:
          context: ${{ matrix.context }}
          file: ${{ matrix.file || format('{0}/Dockerfile', matrix.context) }}
          push: false
          load: true
          tags: mlbox-ci:${{ matrix.name }}-${{ github.sha }}
          cache-from: type=gha,scope=${{ matrix.name }}
          cache-to: type=gha,mode=max,scope=${{ matrix.name }}
      - name: Scan image with Trivy
        uses: aquasecurity/trivy-action@0.28.0
        with:
          image-ref: mlbox-ci:${{ matrix.name }}-${{ github.sha }}
          format: table
          vuln-type: os,library
          severity: CRITICAL,HIGH
          exit-code: '1'
          ignore-unfixed: true
  publish:
    if: github.event_name == 'push' && github.ref == 'refs/heads/master'
    needs: images
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.AWS_ECR_PUBLISH_ROLE_ARN }}
          aws-region: ap-southeast-2
      - uses: aws-actions/amazon-ecr-login@v2
        id: ecr
      - uses: docker/setup-buildx-action@v3
      - name: Build and push
        env:
          REGISTRY: ${{ steps.ecr.outputs.registry }}
          TAG: ${{ github.sha }}
        run: |
          set -euo pipefail
          for item in '. web/dashboard/Dockerfile jhub-gpu-sandbox/dashboard' '. web/bff/Dockerfile jhub-gpu-sandbox/bff' '. images/cpu/Dockerfile jhub-gpu-sandbox/cpu' '. images/gpu/Dockerfile jhub-gpu-sandbox/gpu'; do
            read -r context file image <<< "$item"
            docker buildx build --platform linux/amd64 --file "$file" --tag "$REGISTRY/$image:$TAG" --push "$context"
          done
